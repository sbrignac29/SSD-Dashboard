{
  "name": "ssd-offload-dashboard",
  "version": "0.1.0",
  "description": "Local dashboard that finds old or finished video/photo projects on a working SSD and ranks them for offloading to archive storage.",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/server.js",
  "engines": {
    "node": "^22.14.0 || >=23.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "scan": "node src/cli/scan.js",
    "scan:details": "node src/cli/scan.js --details",
    "report": "node src/cli/report.js",
    "pin": "node src/cli/pin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.0",
    "alpinejs": "^3.15.12",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  }
